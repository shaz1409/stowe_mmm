# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ── Meta ─────────────────────────────────────────────────────────────────────
META_APP_ID=                  # Facebook App ID (Business Manager > App Settings)
META_APP_SECRET=              # Facebook App Secret
META_ACCESS_TOKEN=            # System User token — never a personal token (expires in 60d)
META_AD_ACCOUNT=              # Ad Account ID without the "act_" prefix (e.g. 123456789)

# ── Google Ads ────────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=   # Developer token from Google Ads API Centre
GOOGLE_ADS_CLIENT_ID=         # OAuth2 Client ID (Google Cloud Console)
GOOGLE_ADS_CLIENT_SECRET=     # OAuth2 Client Secret
GOOGLE_ADS_REFRESH_TOKEN=     # Generated via scripts/get_google_refresh_token.py
GOOGLE_ADS_CUSTOMER_ID=       # 10-digit account CID without dashes (leaf account)
GOOGLE_ADS_LOGIN_CUSTOMER_ID= # MCC / manager account CID (if accessing via MCC)

# ── Microsoft Advertising (Bing Ads) ─────────────────────────────────────────
BING_DEVELOPER_TOKEN=         # Developer token from Microsoft Advertising UI
BING_CLIENT_ID=               # Azure AD App client ID
BING_CLIENT_SECRET=           # Azure AD App client secret
BING_REFRESH_TOKEN=           # OAuth2 refresh token (generate via MS auth flow)
BING_ACCOUNT_ID=              # Numeric account ID (not customer ID)
BING_CUSTOMER_ID=             # Numeric customer ID (parent of account)

# ── StackAdapt ────────────────────────────────────────────────────────────────
STACKADAPT_API_TOKEN=         # API token from StackAdapt account manager (not yet used — CSV mode active)

# ── Azure Data Warehouse ──────────────────────────────────────────────────────
# Option A — full connection string (preferred; overrides individual vars below)
AZURE_CONNECTION_STRING=      # e.g. Driver={ODBC Driver 18 for SQL Server};Server=...;Database=...;Uid=...;Pwd=...

# Option B — individual components (used only if AZURE_CONNECTION_STRING is empty)
AZURE_SERVER=                 # e.g. stowe-dw.database.windows.net
AZURE_DATABASE=               # Database name
AZURE_USERNAME=               # SQL login username
AZURE_PASSWORD=               # SQL login password
