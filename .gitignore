# ── Data ──────────────────────────────────────────────────────────────────────
# Never commit raw or processed data (real or dummy)
data/
!data/.gitkeep

# ── All pipeline outputs ───────────────────────────────────────────────────────
outputs/
!outputs/.gitkeep

# ── Config generated by pipeline ──────────────────────────────────────────────
# features.yaml is auto-generated by 03_explore.py — don't track
config/features.yaml

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── R ─────────────────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ── Model artefacts ───────────────────────────────────────────────────────────
# Bayesian posterior samples (can be 100MB+)
*.nc
# Robyn model JSON exports
RobynModel-*.json

# ── Secrets — never commit ────────────────────────────────────────────────────
.env
.env.*
!.env.example
secrets.py
credentials.json
*.pem
*.key

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
