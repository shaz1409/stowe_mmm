# Data — never commit raw or processed data
data/*
!data/.gitkeep

# Model outputs
outputs/robyn/*
!outputs/robyn/.gitkeep
outputs/meridian/*
!outputs/meridian/.gitkeep
outputs/powerbi/*
!outputs/powerbi/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Secrets — never commit
.env
secrets.py
